NATION:"DESTINATION",SPONSOR:"SPONSOR"};var n=e.AR_MODES={GEO_TAG_MODE:"geo_tag_mode",HUNT_MODE:"hunt_mode",SCAN_MODE:"scan_mode"};e.AR_MODES_MENU=[{id:1,label:"Geo-Tag Mode",name:"Geo-Tag",listLabel:"Geo-Tags",mode:n.GEO_TAG_MODE,modeSubTitle1:"The Geo Tag is anchored in front of you, size and position fully customisable",modeSubTitle2:"Snap a creative photo/video with the Geo-Tag",icon:"pinlocation"},{id:2,label:"Hunt Mode",name:"Hunt",listLabel:"Hunts",mode:n.HUNT_MODE,modeSubTitle1:"Users are to follow the arrows to find hidden gems",modeSubTitle2:"TAP the AR to Capture",icon:"huntMode"},{id:3,label:"Scan Mode",name:"Scan",listLabel:"Hidden Gems",mode:n.SCAN_MODE,modeSubTitle1:"Users can scan their environment or QR Code to trigger the AR.",modeSubTitle2:"Snap a photo/video with the AR",icon:"scan"}],e.TEST_HUNT_CHALLENGE={id:102,geo_ar_star:{id:300,name:"Parawhyyy",fun_facts:"<p>un parawhyy</p>",info:"<p>un parawhyy</p>",visibility_radius:10,geo_site:{id:772,name:"TRIBE UNITE AR PIN",image:"https://travel-ar-app-42706.s3.amazonaws.com/media/geoar/img/Screenshot_2025-02-01_at_4.20.09_PM.png?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Credential=AKIA4KGTUZ6KCVNP3RMO%2F20250715%2Fus-east-2%2Fs3%2Faws4_request&X-Amz-Date=20250715T170457Z&X-Amz-Expires=3600&X-Amz-SignedHeaders=host&X-Amz-Signature=71b32d8fa727dc0002d2b4c57010579949cfac568cf7df1be9f1c18126591b92",created_at:"2025-02-01T20:29:34.564198Z",updated_at:"2025-06-12T19:53:15.184061Z",geo_location:142,pin_challenge:{id:202,image:"https://travel-ar-app-42706.s3.amazonaws.com/media/ar/img/352372481_673412104832421_5523699236616023318_n_Skw23Xi.jpg?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Credential=AKIA4KGTUZ6KCVNP3RMO%2F20250715%2Fus-east-2%2Fs3%2Faws4_request&X-Amz-Date=20250715T170457Z&X-Amz-Expires=3600&X-Amz-SignedHeaders=host&X-Amz-Signature=cbd0551947fcf2358024f829f67d81855e4bc0c98f0589f2daffc24e4a516977",model_file:"https://travel-ar-app-42706.s3.amazonaws.com/media/ar/model/TribePinFinal_8o87Thq.zip?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Credential=AKIA4KGTUZ6KCVNP3RMO%2F20250715%2Fus-east-2%2Fs3%2Faws4_request&X-Amz-Date=20250715T170457Z&X-Amz-Expires=3600&X-Amz-SignedHeaders=host&X-Amz-Signature=726de21a47ea9b1b03c96880c1b1dbc3802a8c6bae40613b5bf09379c270fc9e",name:"TRIBE Pin",description:"<h3><strong>\ud83d\udccd Geo Check-In with Tribe!</strong></h3>\r\n\r\n<p>Capture your party shots with TRIBE&#39;s Geo Check-In Experience&nbsp;for in-app points, climb the scoreboard for a chance to WIN weekly ticket giveways!&nbsp;</p>\r\n\r\n<h3><strong>How to Play</strong></h3>\r\n\r\n<p>\u2705 <strong>Unlock the Tribe AR Pin</strong> &ndash; It appears when you&#39;re at select events nationwide.&nbsp;<br />\r\n\u2705 <strong>Customize Your Shot</strong> &ndash; Resize and position the pin for the perfect frame.<br />\r\n\u2705 <strong>Snap Your Photo</strong> &ndash; Stand in frame with the AR Pin. (Only works while you are at the event)<br />\r\n\u2705 <strong>Share to Earn Points</strong> &ndash; Use the app&rsquo;s share buttons to post on social media.&nbsp;</p>\r\n\r\n<h3><strong>Scoring</strong></h3>\r\n\r\n<p>\ud83c\udf9f\ufe0f 3 points for participation<br />\r\n\u2795 +1 point per extra platform (IG, FB, TikTok)<br />\r\n\u26d4 No share, NO Points&nbsp;</p>\r\n\r\n<h3><strong>Check-In Limits</strong></h3>\r\n\r\n<p>\ud83d\udccd Max 10 check-ins per 24 hours.</p>\r\n\r\n<p><strong>Have you Geo Checked-In as yet?</strong></p>",points:3,challenge_choice:"3DMODEL",challenge_requirement:"PHOTO",created_at:"2025-01-30T17:01:09.531069Z",expiry_date:"2026-07-31T17:01:04Z",sponsored:{id:13,name:"TRIBE",image:"https://travel-ar-app-42706.s3.amazonaws.com/media/sponsor/img/352372481_673412104832421_5523699236616023318_n.jpg?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Credential=AKIA4KGTUZ6KCVNP3RMO%2F20250715%2Fus-east-2%2Fs3%2Faws4_request&X-Amz-Date=20250715T170457Z&X-Amz-Expires=3600&X-Amz-SignedHeaders=host&X-Amz-Signature=fd3fee1710b9eff99e972386e0c7c28d7785860899a6ebe1179cbafef7d6e84a",description:"",tags:"@carnivaltribe, @roamreality, #carnivaltribe #roamreality",created_at:"2024-12-20T01:51:31.276587Z"},parameters:{id:206,name:"Tribe Pin",bloom_threshold:"0.90",bloom_intensity:"3.00",positionX:"0.000",positionY:"0.000",positionZ:"0.900",scale_object:"1.00000",emission_value:"1.00",rotation_speed:"0.50",scale_speed:"0.0015",min_pinch_scale:"0.5000",max_pinch_scale:"3.000",isRotationEnabled:!0,loop_animations:!1,loop_delay:1e3,diffuse_text_color:"#ffffff",diffuse_intensity:"1.00",sound_play_and_pause:!1,image_opacity:!1,image_opacity_value:"1.00",tracking_and_anchors:!1,ar_portals:!1,image_recognition:!1,image_recognition_file:null},info:"<h3><strong>\ud83d\udccd Geo Check-In with Tribe!</strong></h3>\r\n\r\n<p>Capture your party shots with TRIBE&#39;s Geo Check-In Experience&nbsp;for in-app points, climb the scoreboard for a chance to WIN weekly ticket giveways!&nbsp;</p>\r\n\r\n<h3><strong>How to Play</strong></h3>\r\n\r\n<p>\u2705 <strong>Unlock the Tribe AR Pin</strong> &ndash; It appears when you&#39;re at select events nationwide.&nbsp;<br />\r\n\u2705 <strong>Customize Your Shot</strong> &ndash; Resize and position the pin for the perfect frame.<br />\r\n\u2705 <strong>Snap Your Photo</strong> &ndash; Stand in frame with the AR Pin. (Only works while you are at the event)<br />\r\n\u2705 <strong>Share to Earn Points</strong> &ndash; Use the app&rsquo;s share buttons to post on social media.&nbsp;</p>\r\n\r\n<h3><strong>Scoring</strong></h3>\r\n\r\n<p>\ud83c\udf9f\ufe0f 3 points for participation<br />\r\n\u2795 +1 point per extra platform (IG, FB, TikTok)<br />\r\n\u26d4 No share, NO Points&nbsp;</p>\r\n\r\n<h3><strong>Check-In Limits</strong></h3>\r\n\r\n<p>\ud83d\udccd Max 10 check-ins per 24 hours.</p>\r\n\r\n<p><strong>Have you Geo Checked-In as yet?</strong></p>",color:"#f86604"},address_text:"\ud83d\udccdHasely Crawford Stadium - Training Field",lat_long:{type:"Point",coordinates:[-57.589505910873385,-25.29671858919541]},geo_site_border:{type:"MultiLineString",coordinates:[[[-57.59174823760985,-25.297087189244408],[-57.590246200561516,-25.293304135468663],[-57.58443117141721,-25.295670982937093],[-57.5869846343994,-25.29904657069071],[-57.591812610626214,-25.297048389292033]]]},description:'<h3><span style="color:#ffffff">Two crews, ONE mission. TRIBE x SCORCH</span></h3>\r\n\r\n<h3><span style="color:#ffffff">Choose the way you UNITE!</span> \ud83e\udd29</h3>\r\n\r\n<p>On Carnival Thursday, we UNITE as ONE! \ud83d\udd25TRIBE X SCORCH\ud83d\udd25</p>\r\n\r\n<p>\ud83d\udcc5 When:&nbsp;Carnival Thursday, February 27th, 2025 @&nbsp;&nbsp;9:00pm-4:00am</p>\r\n\r\n<p>\ud83c\udf9f\ufe0f Tickets:&nbsp;https://islandetickets.com/event/UNITE&nbsp;<a href="https://islandetickets.com/event/UNITE\xa0">Island E-Tickets - UNITE</a></p>\r\n\r\n<p>\ud83d\udcf1 Tribe IG:&nbsp;<a href="https://www.instagram.com/p/DFLUfjoOrsQ/?img_index=1">Unite Post</a></p>',info:'<h3><span style="color:#ffffff">Two crews, ONE mission. TRIBE x SCORCH</span></h3>\r\n\r\n<h3><span style="color:#ffffff">Choose the way you UNITE!</span> \ud83e\udd29</h3>\r\n\r\n<p>- Bring your own cooler \ud83e\uddca<br />\r\n- \u2060Pre-Stocked cooler package\ud83c\udf7b<br />\r\n- Cart with your crew \ud83d\udc6f&zwj;\u2642\ufe0f\ud83d\udc6f&zwj;\u2642\ufe0f<br />\r\n- Premium Drinks Inclusive Section \ud83c\udf79<br />\r\n- VIP cabana \u2b50\ufe0f</p>\r\n\r\n<p>On Carnival Thursday, we UNITE as ONE! \ud83d\udd25TRIBE X SCORCH\ud83d\udd25</p>\r\n\r\n<p>\ud83d\udcc5 When:&nbsp;Carnival Thursday, February 27th, 2025 @&nbsp;&nbsp;9:00pm-4:00am</p>\r\n\r\n<p>\ud83d\udccdLocation: Hasely Crawford Stadium - Training Field</p>\r\n\r\n<p>\ud83c\udf9f\ufe0f Tickets:&nbsp;https://islandetickets.com/event/UNITE&nbsp;<a href="https://islandetickets.com/event/UNITE\xa0">Island E-Tickets - UNITE</a></p>\r\n\r\n<p>\ud83d\udcf1 Tribe IG:&nbsp;<a href="https://www.instagram.com/p/DFLUfjoOrsQ/?img_index=1">Unite Post</a></p>',pro_tips:'<p>\ud83d\udccd<strong>Location:</strong> Hasely Crawford Stadium - Training Field</p>\r\n\r\n<p>\ud83d\udcc5 <strong>Date:</strong>&nbsp;Carnival Thursday, February 27th, 2025</p>\r\n\r\n<p>\u23f0 <strong>Time:</strong>&nbsp;9:00pm-4:00am</p>\r\n\r\n<p><strong>\ud83d\udcf1 Tribe IG</strong>:&nbsp;<a href="https://www.instagram.com/p/DFLUfjoOrsQ/?img_index=1">Unite Post</a></p>\r\n\r\n<p><strong>\ud83c\udf9f\ufe0f Tickets:&nbsp;</strong>https://islandetickets.com/event/UNITE&nbsp;<a href="https://islandetickets.com/event/UNITE\xa0">Island E-Tickets - UNITE</a></p>\r\n\r\n<p><strong>\ud83c\udf9f\ufe0f Price:</strong> Early Bird Cooler Special $400TT&nbsp;</p>\r\n\r\n<p>\ud83c\udf77 Premium Drinks Inclusive: $800TT</p>',check_ins:10,check_in_site_radius:1e3,category:{id:169,name:"The Lost Tribe",color:"#000000"},challenge_attempt:10,user_attempts:0,sponsor:{id:13,name:"TRIBE",image:"https://travel-ar-app-42706.s3.amazonaws.com/media/sponsor/img/352372481_673412104832421_5523699236616023318_n.jpg?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Credential=AKIA4KGTUZ6KCVNP3RMO%2F20250715%2Fus-east-2%2Fs3%2Faws4_request&X-Amz-Date=20250715T170457Z&X-Amz-Expires=3600&X-Amz-SignedHeaders=host&X-Amz-Signature=fd3fee1710b9eff99e972386e0c7c28d7785860899a6ebe1179cbafef7d6e84a",description:"",tags:"@carnivaltribe, @roamreality, #carnivaltribe #roamreality",created_at:"2024-12-20T01:51:31.276587Z"},is_active:!0,band_user:null},challenges:{id:135,image:null,model_file:"https://travel-ar-app-42706.s3.amazonaws.com/media/ar/model/pin1_xUypgMi.zip?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Credential=AKIA4KGTUZ6KCVNP3RMO%2F20250715%2Fus-east-2%2Fs3%2Faws4_request&X-Amz-Date=20250715T170457Z&X-Amz-Expires=3600&X-Amz-SignedHeaders=host&X-Amz-Signature=004aa9983da0f2e4e90a910dd8ff6e2cff0daf5183cf5a5ec73354115d31287d",name:"Asuncion - Geo AR Challenge",description:"<p>8pala</p>",points:1,challenge_choice:"IMAGE",challenge_requirement:"PHOTO",created_at:"2024-10-07T13:53:45.682952Z",expiry_date:null,sponsored:{id:12,nam